NODE_ENV=test

# Fixed so AES-256-GCM key derivation is deterministic
# (src/integrations/github/credentials.ts).
DB_ENCRYPTION_KEY=e2e-test-secret-do-not-use-outside-tests-0000

# BriefSlackService config.getOrThrows this to build the "view in app" link.
FRONTEND_URL=http://localhost:5173

# API_TOKEN is not set here: setup-file.ts writes it from the same constant the
# request helper sends, so the guard and the tests cannot drift apart.
#
# No GitHub / OpenAI / Slack credentials on purpose. Those modules
# provide rejecting stubs when their settings are absent, and every one of
# their network seams is aliased to src/__mocks__/ in vitest.e2e.config.ts.

# buildPinoConfig builds a pino-roll file target even at silent level, and the
# default path points at the real <repo-root>/logs/.
LOG_LEVEL=silent
LOG_FILE_PATH=./.e2e-logs/app.log

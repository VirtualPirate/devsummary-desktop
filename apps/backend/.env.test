NODE_ENV=test

# Fixed so AES-256-GCM key derivation and OTP behaviour are deterministic.
BETTER_AUTH_SECRET=e2e-test-secret-do-not-use-outside-tests-0000
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Placeholders. The `resend` module is mocked, but getOrThrow still runs.
RESEND_API_KEY=re_test_placeholder
EMAIL_FROM=test@example.com

# Empty => auth.config.ts omits both socialProviders and the
# account.accountLinking block, whichever values the developer's .env holds.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=e2e
TEMPORAL_MANAGE_SCHEDULES=false

# buildPinoConfig builds a pino-roll file target even at silent level, and the
# default path points at the real <repo-root>/logs/.
LOG_LEVEL=silent
LOG_FILE_PATH=./.e2e-logs/app.log

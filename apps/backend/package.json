{
  "name": "backend",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest --config vitest.e2e.config.ts",
    "db:generate": "kysely migrate:make",
    "db:up": "kysely migrate:latest",
    "db:down": "kysely migrate:down",
    "db:status": "kysely migrate:list",
    "db:fresh": "kysely migrate:rollback --all && kysely migrate:latest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.16",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.13",
    "@launchstack/api-interfaces": "workspace:^",
    "@launchstack/core": "workspace:^",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-paginate-rest": "^14.0.0",
    "deepagents": "^1.14.0",
    "express": "^5.2.1",
    "kysely": "^0.28.17",
    "langchain": "^1.5.11",
    "nestjs-pino": "^4.4.0",
    "openai": "^6.37.0",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "pino-roll": "^3.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-environment-node": "^30.0.0",
    "kysely-ctl": "^0.21.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@octokit/core$": "<rootDir>/__mocks__/@octokit/core.ts",
      "^@octokit/plugin-paginate-rest$": "<rootDir>/__mocks__/@octokit/plugin-paginate-rest.ts",
      "^openai$": "<rootDir>/__mocks__/openai.ts",
      "^openai/helpers/zod$": "<rootDir>/__mocks__/openai/helpers/zod.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

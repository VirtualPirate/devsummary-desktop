# apps/backend/.env — headless development only.
#
# In normal operation none of this is needed: the Electron main process forks
# the backend and hands it API_TOKEN, DATA_DIR, DB_ENCRYPTION_KEY and the
# credential bundle it decrypted out of the OS keychain. A .env exists so
# `pnpm start:dev` (backend on its own, no shell) has somewhere to read from.
#
# There is no DATABASE_URL: the database is PGlite, a directory on disk.

# --- Supplied by the Electron shell in normal operation ---

# Per-boot bearer token for LocalTokenGuard. Every request outside /api/health*
# must send it as `x-desktop-token`; without it, everything answers 401.
# openssl rand -hex 32
API_TOKEN=

# Parent of the PGlite directory — the database lands in $DATA_DIR/data.
# The shell sets this to app.getPath('userData'). Unset falls back to ./.data.
DATA_DIR=

# Passphrase the AES-256-GCM key derives from (scrypt). Protects the stored
# GitHub PAT and Slack bot token. Generated once by the shell and then STABLE —
# changing it costs a re-paste of both. Unset means an ephemeral per-boot key.
# openssl rand -hex 32
DB_ENCRYPTION_KEY=

# Used to build the "view in app" link in brief emails and Slack posts. Both
# leaf senders getOrThrow it, so delivery fails without it.
FRONTEND_URL=http://localhost:5173

# --- The credential bundle ---
#
# All optional. These are what the settings screen writes: PUT
# /api/local-settings/credentials updates them in memory AND in process.env,
# then asks the shell to re-encrypt the bundle. Every value here is read live,
# so a change takes effect on the next job rather than the next launch.

# Fine-grained personal access token: Contents Read-only + Metadata Read-only on
# the repositories you want. The authoritative copy is the encrypted
# github.installations row; this mirrors it.
GITHUB_TOKEN=

# LLM provider — which one answers AI calls: `openai` (default), `gemini`,
# `claude-code`, `opencode` or `cursor` (a coding-agent CLI on this machine,
# no API key — it uses the login you already have in your terminal). Normally
# written by the AI settings page, not here. A value that is not a known
# provider throws rather than falling back. The per-scope overrides
# COMMIT_ANALYSIS_LLM_PROVIDER / BRIEFS_LLM_PROVIDER win over this one and are
# env-only — no UI writes them.
LLM_PROVIDER=openai

# Required for commit analysis and brief generation with a key provider: the
# *selected* provider's key. Missing means both fail with
# OPENAI_NOT_CONFIGURED; nothing else breaks. The other provider's key can stay
# unset, and a CLI provider needs none at all.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_COMMIT_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_BRIEF_MODEL=gpt-4o-mini
GEMINI_COMMIT_ANALYSIS_MODEL=gemini-3.1-flash-lite
GEMINI_BRIEF_MODEL=gemini-3.1-flash-lite
# Aliases or full ids accepted by `claude --model`.
CLAUDE_CODE_COMMIT_ANALYSIS_MODEL=haiku
CLAUDE_CODE_BRIEF_MODEL=sonnet
# Always `provider/model`, as printed by `opencode models`. The default needs
# `opencode auth login` → OpenCode Zen; a free model still needs the account.
OPENCODE_COMMIT_ANALYSIS_MODEL=opencode/big-pickle
OPENCODE_BRIEF_MODEL=opencode/big-pickle
# Cursor model ids are printed by `agent --list-models`; `auto` is also valid.
CURSOR_COMMIT_ANALYSIS_MODEL=composer-2.5-fast
CURSOR_BRIEF_MODEL=composer-2.5

# SMTP — your own mailbox sends the briefs (Gmail app password, Fastmail, a
# company relay). Host, user and password are all required for the email channel
# to count as configured. EMAIL_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Slack bot token (xoxb-…), from a Slack app granted chat:write, channels:read,
# groups:read, users:read. Mirrors the encrypted slack.installations row.
SLACK_BOT_TOKEN=

# --- Tuning ---

# Process timezone, defaulted to UTC by main.ts. Set it in the real process
# environment (shell, launchd) — the default is applied before this file is
# parsed and ConfigModule does not override an existing var, so a value here
# alone has no effect. Brief cadences are unaffected either way; they resolve in
# each schedule's own timezone.
TZ=UTC

BRIEFS_DISPATCHER_INTERVAL_SECONDS=60
BRIEFS_MAX_PROMPT_CHARS=30000
# Max briefs created per schedule backfill. A backstop only: the binding limit
# is MAX_HISTORY_DAYS (90), which planBackfill clamps the lookback to, so a
# daily schedule tops out around 91 windows regardless of this value.
BRIEFS_BACKFILL_MAX_BRIEFS=100
# Schedules claimed per dispatch tick. A full batch is logged at warn — that is
# the only signal the ceiling is throttling delivery.
BRIEFS_DISPATCH_BATCH_SIZE=100
# How long a brief may sit `pending` before dispatch re-claims it. Covers the
# process dying after claimDue committed but before generation started.
BRIEFS_PENDING_REAP_MINUTES=15
# Each schedule backfills up to BRIEFS_BACKFILL_MAX_BRIEFS briefs, one LLM
# call apiece, so the per-workspace count is capped.
BRIEFS_MAX_SCHEDULES_PER_ORG=20

# Logging. Path is resolved relative to apps/backend, so ../../logs/app.log is
# <repo-root>/logs/app.log.
LOG_LEVEL=info
LOG_FILE_PATH=../../logs/app.log
LOG_FILE_MAX_SIZE=50M
LOG_FILE_KEEP_FILES=7

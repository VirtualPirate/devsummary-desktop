DATABASE_URL=postgresql://launchstack:launchstack@localhost:11753/launchstack
BETTER_AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# Process timezone, defaulted to UTC by main.ts / worker.ts. Set it in the real
# process environment (shell, compose, systemd) — the default is applied before
# this file is parsed, and ConfigModule does not override an existing var, so a
# value here alone has no effect. Override only for BOTH processes at once: the
# `auth` schema stores naive timestamps, so an API/worker mismatch shifts
# session and OTP expiry. Brief cadences are unaffected either way — they
# resolve in the schedule's own timezone.
TZ=UTC

# Google OAuth (optional - omit to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Internal smoke-test endpoint (POST /api/_internal/queue/noop)
INTERNAL_API_TOKEN=replace-with-openssl-rand-hex-32

GITHUB_APP_ID=
GITHUB_APP_SLUG=              # URL slug used to build the install URL
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
<your-github-app-private-key>
-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_SECRET=
GITHUB_APP_CLIENT_ID=

# OpenAI — required for commit analysis
OPENAI_API_KEY=
OPENAI_COMMIT_ANALYSIS_MODEL=gpt-4o-mini

# --- Briefs ---
# OPENAI_API_KEY (above) is shared with commit analysis.
OPENAI_BRIEF_MODEL=gpt-4o-mini
BRIEFS_DISPATCHER_INTERVAL_SECONDS=60
BRIEFS_MAX_PROMPT_CHARS=30000
# Max briefs created per schedule backfill. A backstop only: the binding limit
# is MAX_HISTORY_DAYS (90), which planBackfill clamps the lookback to, so a
# daily schedule tops out around 91 windows regardless of this value.
BRIEFS_BACKFILL_MAX_BRIEFS=100
# Schedules claimed per dispatch tick. A full batch is logged at warn — that is
# the only signal the ceiling is throttling delivery.
BRIEFS_DISPATCH_BATCH_SIZE=100
# How long a brief may sit `pending` before dispatch re-claims it. Covers a
# worker dying after claimDue committed but before the child workflow started.
BRIEFS_PENDING_REAP_MINUTES=15
# Each schedule backfills up to BRIEFS_BACKFILL_MAX_BRIEFS briefs, one OpenAI
# call apiece, so the per-org count is capped.
BRIEFS_MAX_SCHEDULES_PER_ORG=20

# Slack integration (optional — omit any of CLIENT_ID/CLIENT_SECRET/REDIRECT_URI to disable)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/installations/callback
# Optional: comma-separated scopes override (defaults: chat:write,channels:read,groups:read,users:read,channels:join)
SLACK_SCOPES=

# Logging
LOG_LEVEL=info
# Path is resolved relative to apps/backend (the cwd of `pnpm dev:backend`).
# `../../logs/app.log` points at <repo-root>/logs/app.log, the dir that
# docker-compose.yaml bind-mounts into the OTel Collector container.
LOG_FILE_PATH=../../logs/app.log

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=launchstack
# API process manages Temporal schedules; worker.ts sets this false
TEMPORAL_MANAGE_SCHEDULES=true
